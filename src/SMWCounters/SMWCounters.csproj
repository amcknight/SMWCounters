<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LiveSplit</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net4.8.1</TargetFramework>
    <AssemblyName>SMWCounters</AssemblyName>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- So Visual Studio's fast up-to-date check doesn't skip the post-build
         copy-to-Components step below (the CLI runs it every build regardless). -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <Version>0.3.0</Version>
    <Company>Andrew McKnight</Company>
    <Product>LiveSplit SMW Counters</Product>
  </PropertyGroup>

  <PropertyGroup>
    <!-- LiveSplit release whose LiveSplit.Core.dll the standalone/CI build references.
         Keep in sync with scripts/fetch-livesplit-core.ps1 and the release workflow. -->
    <LiveSplitVersion>1.8.37</LiveSplitVersion>
  </PropertyGroup>

  <!-- Super-repo dev: build against LiveSplit source when the super-repo provides LsSrcPath. -->
  <ItemGroup Condition="'$(LsSrcPath)' != ''">
    <ProjectReference Include="$(LsSrcPath)\LiveSplit.Core\LiveSplit.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Standalone / CI: reference the prebuilt LiveSplit.Core.dll fetched into lib/. -->
  <ItemGroup Condition="'$(LsSrcPath)' == ''">
    <Reference Include="LiveSplit.Core">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\LiveSplit.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- LiveSplit.Core's public API (e.g. IComponent.Update) surfaces UpdateManager
         types (IUpdateable) at compile time; fetched alongside LiveSplit.Core.dll. -->
    <Reference Include="UpdateManager">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\UpdateManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SNES.dll: structural WRAM discovery (snes_offsets project). Default is
       the pinned binary in lib/ (committed; see .gitignore carve-out).
       Private=true because LiveSplit does NOT provide this assembly — it must
       ship next to SMWCounters.dll. Set SnesSrcPath in the gitignored
       SMWCounters.local.props to build against ../snes_offsets source instead
       (requires the sibling LiveSplit checkout that SNES.csproj references). -->
  <ItemGroup Condition="'$(SnesSrcPath)' != ''">
    <ProjectReference Include="$(SnesSrcPath)\src\SNES\SNES.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SnesSrcPath)' == ''">
    <Reference Include="SNES">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\SNES.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Dev convenience: after a build, drop the component DLL (+pdb) into a local
       LiveSplit Components folder so a rebuild is picked up on the next LiveSplit
       restart with no manual copy. The destination is machine-specific, so set
       ComponentsPath in a gitignored SMWCounters.local.props (imported below) or
       pass -p:ComponentsPath=... . The copy is skipped when the folder is absent
       (CI, other machines, or no local props). -->
  <Import Project="$(MSBuildThisFileDirectory)SMWCounters.local.props" Condition="Exists('$(MSBuildThisFileDirectory)SMWCounters.local.props')" />

  <Target Name="CopyToLiveSplitComponents" AfterTargets="Build" Condition="Exists('$(ComponentsPath)')">
    <!-- SMWCounters.dll and the SNES.dll it was built against deploy as a
         pair so LiveSplit can never load a mismatched set. ContinueOnError:
         a running LiveSplit locks loaded DLLs; warn (close it) instead of
         failing the build. Touch: stamp the copy time so a rebuild visibly
         updates the file. -->
    <ItemGroup>
      <_DeployPair Include="$(TargetPath);$(TargetDir)SNES.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployPair)" DestinationFolder="$(ComponentsPath)" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedDll" />
    </Copy>
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ComponentsPath)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" ContinueOnError="true" />
    <Touch Files="$(ComponentsPath)\$(TargetFileName)" ContinueOnError="true" />
    <Message Condition="'@(_DeployedDll->Count())' == '@(_DeployPair->Count())'" Importance="high"
             Text="SMWCounters: deployed @(_DeployedDll->'%(Filename)%(Extension)', ', ') -> $(ComponentsPath)" />
    <Warning Condition="'@(_DeployedDll->Count())' != '@(_DeployPair->Count())'"
             Text="Deployed only [@(_DeployedDll->'%(Filename)%(Extension)', ', ')] of the SMWCounters.dll+SNES.dll pair: LiveSplit likely has the rest locked. Close LiveSplit and rebuild." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\death.png">
      <LogicalName>LiveSplit.SmwCounters.Assets.death.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\moon.png">
      <LogicalName>LiveSplit.SmwCounters.Assets.moon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\exit.png">
      <LogicalName>LiveSplit.SmwCounters.Assets.exit.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\jump.png">
      <LogicalName>LiveSplit.SmwCounters.Assets.jump.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\mushroom.png">
      <LogicalName>LiveSplit.SmwCounters.Assets.mushroom.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\kill.png">
      <LogicalName>LiveSplit.SmwCounters.Assets.kill.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
